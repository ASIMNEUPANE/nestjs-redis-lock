{
  "name": "nestjs-redlock-cron-dedup",
  "version": "1.0.0",
  "private": true,
  "description": "Cron deduplication example — prevent duplicate job execution across multiple NestJS instances",
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node-dev --respawn src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "cron": "^3.0.0",
    "ioredis": "^5.4.0",
    "nestjs-redlock": "^1.2.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
