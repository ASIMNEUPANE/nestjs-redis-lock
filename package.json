{
  "name": "nestjs-redlock",
  "version": "0.1.0",
  "description": "Production-ready distributed locking for NestJS. Decorator-first, type-safe.",
  "author": "Asim Neupane <asimneupane11@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asimneupane/nestjs-redis-lock.git"
  },
  "homepage": "https://github.com/asimneupane/nestjs-redis-lock#readme",
  "bugs": {
    "url": "https://github.com/asimneupane/nestjs-redis-lock/issues"
  },
  "keywords": [
    "nestjs",
    "redis",
    "lock",
    "distributed-lock",
    "redlock",
    "mutex",
    "concurrency",
    "race-condition",
    "decorator",
    "typescript",
    "ioredis",
    "semaphore",
    "distributed-systems"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "redlock": "^5.0.0-beta.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "ioredis": ">=5.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "ioredis": "^5.4.0",
    "ioredis-mock": "^8.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
