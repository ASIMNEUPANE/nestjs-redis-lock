{
  "name": "nestjs-redlock",
  "version": "1.2.0",
  "description": "Production-ready distributed locking for NestJS. Decorator-first, type-safe.",
  "author": "Asim Neupane <asimneupane11@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asimneupane/nestjs-redis-lock.git"
  },
  "homepage": "https://github.com/asimneupane/nestjs-redis-lock#readme",
  "bugs": {
    "url": "https://github.com/asimneupane/nestjs-redis-lock/issues"
  },
  "keywords": [
    "nestjs",
    "redis",
    "lock",
    "distributed-lock",
    "redlock",
    "mutex",
    "concurrency",
    "race-condition",
    "decorator",
    "typescript",
    "ioredis",
    "semaphore",
    "read-write-lock",
    "fencing-token",
    "distributed-systems",
    "opentelemetry",
    "observability"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./tracing": {
      "import": {
        "types": "./dist/lock.tracing.d.mts",
        "default": "./dist/lock.tracing.mjs"
      },
      "require": {
        "types": "./dist/lock.tracing.d.ts",
        "default": "./dist/lock.tracing.js"
      }
    }
  },
  "files": [
    "dist",
    "testing.js",
    "testing.d.ts",
    "tracing.js",
    "tracing.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config jest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" && npm run typecheck",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "redlock": "^5.0.0-beta.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@nestjs/terminus": ">=10.0.0",
    "@opentelemetry/api": ">=1.3.0",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/terminus": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/testing": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "ioredis": "^5.4.0",
    "ioredis-mock": "^8.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
